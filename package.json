{
  "name": "back-product-paid",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "main": "build/index.js",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "typescript",
    "express",
    "js",
    "node-js"
  ],
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "coverage": "jest --coverage --runInBand --forceExit",
    "coverage:report": "jest --coverage --runInBand --detectOpenHandles --forceExit",
    "coverage:web": "npm run coverage:report && http-server coverage/lcov-report",
    "test": "npm run lint && jest",
    "test:only": "npm run lint && export DEBUG=bdb:* && jest -t $1",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "npm run lint -- --fix",
    "prettier:all": "prettier \"**/*.{ts,js,json,html,scss,md}\" --write",
    "prettier": "prettier \"**/*.{ts,js,json,html,scss,md}\" --check"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1104.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0",
    "@codegenie/serverless-express": "^4.15.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.0",
    "axios": "^1.7.2",
    "body-parser": "^1.20.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "debug": "^4.3.4",
    "express": "^4.19.2",
    "express-openapi-validator": "^5.0.0",
    "http-status-codes": "^2.3.0",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.2",
    "@nestjs/testing": "^10.3.10",
    "@types/aws-lambda": "^8.10.141",
    "@types/chai": "^4.3.1",
    "@types/debug": "^4.1.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/mocha": "^9.1.1",
    "@types/node": "^20.14.2",
    "@types/sinon": "^10.0.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "chai": "^4.3.6",
    "chai-http": "^4.3.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^3.0.0",
    "jest": "^29.7.0",
    "mocha": "^9.2.2",
    "prettier": "^3.8.3",
    "sinon": "^13.0.2",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.21.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "node"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^@decorators/(.*)$": "<rootDir>/infrastructure/decorators/$1",
      "^@cases/(.*)$": "<rootDir>/application/cases/$1",
      "^@dto/(.*)$": "<rootDir>/domain/dto/$1",
      "^@config$": "<rootDir>/config",
      "^@interceptors/(.*)$": "<rootDir>/application/interceptors/$1",
      "^@utilities/(.*)$": "<rootDir>/application/utilities/$1",
      "^@middlewares/(.*)$": "<rootDir>/infrastructure/middlewares/$1",
      "^@common/(.*)$": "<rootDir>/common/$1"
    },
    "testRegex": ".*\\.(spec|test)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.test.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "\\.spec\\.ts$",
      "\\.test\\.ts$"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}